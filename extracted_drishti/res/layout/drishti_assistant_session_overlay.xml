<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistant_root_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/assistant_scrim"
    android:clickable="true"
    android:focusable="false"
    android:contentDescription="Tap outside to dismiss assistant">

    <!-- Native Assistant Bottom Sheet -->
    <LinearLayout
        android:id="@+id/assistant_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_assistant_sheet"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Native Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_assistant_drag_handle"
            android:importantForAccessibility="no" />

        <!-- Header: Assistant Branding & State Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Assistant Branding -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/drishti_logo_eye"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/assistant_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drishti"
                    android:textColor="@color/assistant_primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Animated State Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_assistant_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <com.example.drishti.voice.AssistantStatusDotView
                    android:id="@+id/assistant_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/assistant_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening..."
                    android:textColor="@color/assistant_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Context Prompt -->
        <TextView
            android:id="@+id/assistant_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="What can I help with?"
            android:textColor="@color/assistant_secondary_text"
            android:textSize="14sp" />

        <!-- Live Transcription Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_assistant_transcription_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/assistant_transcription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:text="Listening..."
                android:textColor="@color/assistant_primary_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:accessibilityLiveRegion="polite" />
        </FrameLayout>

        <!-- Response Feedback (visible when speaking / executing) -->
        <TextView
            android:id="@+id/assistant_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_assistant_response_box"
            android:padding="14dp"
            android:textColor="@color/assistant_response_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive" />

        <!-- Real Capabilities Suggestion Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="TRY SAYING"
            android:textColor="@color/assistant_secondary_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Real Capabilities Suggestion Chips Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_assistant_suggestion_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🕒 What time is it?"
                android:textColor="@color/assistant_suggestion_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_assistant_suggestion_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🔋 Battery level"
                android:textColor="@color/assistant_suggestion_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real Capabilities Suggestion Chips Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_assistant_suggestion_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚙️ Open settings"
                android:textColor="@color/assistant_suggestion_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_assistant_suggestion_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🚨 Emergency SOS"
                android:textColor="@color/assistant_suggestion_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Accessible Cancel Button -->
        <Button
            android:id="@+id/assistant_cancel_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_assistant_cancel_btn"
            android:text="Cancel"
            android:textColor="@color/assistant_cancel_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Cancel assistant session" />

    </LinearLayout>
</FrameLayout>
